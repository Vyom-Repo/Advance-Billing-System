# =============================================================================
# Advance Billing — .env.example
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit your .env file to Git.
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your actual values
#   python manage.py migrate
#   python manage.py runserver
#
# =============================================================================


# =============================================================================
# DJANGO ENVIRONMENT
# =============================================================================
# Controls which settings file is loaded.
# Options: development | production
DJANGO_ENV=development

# The Django settings module path.
# development → core.settings.development
# production  → core.settings.production
DJANGO_SETTINGS_MODULE=core.settings.development


# =============================================================================
# SECURITY
# =============================================================================

# REQUIRED: Django secret key. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here-generate-a-new-one

# Debug mode. Set to False in production. NEVER set True in production.
DEBUG=True

# Comma-separated list of allowed hosts.
# Development: localhost,127.0.0.1
# Production: advancebilling.in,www.advancebilling.in
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of trusted origins for CSRF.
# Must include the scheme (http:// or https://).
# Development: http://localhost:8000,http://127.0.0.1:8000
# Production: https://advancebilling.in,https://www.advancebilling.in
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000


# =============================================================================
# DATABASE
# =============================================================================

# PostgreSQL connection URL format:
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE
#
# Development: Leave empty to use SQLite (zero configuration).
# Production: Must be a valid PostgreSQL URL.
#
# Render provides this as RENDER_DATABASE_URL automatically.
DATABASE_URL=


# =============================================================================
# TIMEZONE
# =============================================================================

# Indian Standard Time (IST) — UTC+5:30
# Full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIME_ZONE=Asia/Kolkata


# =============================================================================
# EMAIL (Brevo / Sendinblue)
# =============================================================================

# Django email backend.
# Development: django.core.mail.backends.console.EmailBackend (prints to terminal)
# Production:  anymail.backends.brevo.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Brevo API key. Get from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your-brevo-api-key-here

# Verified sender email address in Brevo
BREVO_SENDER_EMAIL=noreply@yourdomain.com

# Default from email displayed to recipients
DEFAULT_FROM_EMAIL=Advance Billing <noreply@yourdomain.com>


# =============================================================================
# CLOUDINARY (Media Storage)
# =============================================================================
# Cloudinary stores uploaded images (logos, letterheads) in production.
# Development: Leave empty to use local filesystem storage.
# Get credentials from: https://cloudinary.com/console

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret


# =============================================================================
# STATIC & MEDIA FILES
# =============================================================================

# URL prefix for static files
STATIC_URL=/static/

# Filesystem path where collectstatic writes files (production)
STATIC_ROOT=staticfiles

# URL prefix for user-uploaded media
MEDIA_URL=/media/

# Filesystem path for user-uploaded media (development only)
MEDIA_ROOT=media


# =============================================================================
# SECURITY HEADERS (set to True in production)
# =============================================================================

# Ensure session cookie is only sent over HTTPS
SESSION_COOKIE_SECURE=False

# Ensure CSRF cookie is only sent over HTTPS
CSRF_COOKIE_SECURE=False

# Redirect all HTTP requests to HTTPS
SECURE_SSL_REDIRECT=False


# =============================================================================
# RENDER DEPLOYMENT (optional — auto-detected)
# =============================================================================

# Render automatically provides this as the external hostname.
# Example: advance-billing.onrender.com
# If set, it will be automatically added to ALLOWED_HOSTS and CSRF_TRUSTED_ORIGINS.
RENDER_EXTERNAL_HOSTNAME=
